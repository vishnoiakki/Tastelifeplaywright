{
  "name": "tastelife_automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:forgot-password": "playwright test tests/forgot-password.spec.ts --project=chromium",
    "test:forgot-password:headed": "playwright test tests/forgot-password.spec.ts --project=chromium --headed",
    "test:login": "playwright test tests/login.spec.ts --project=chromium",
    "test:login:headed": "playwright test tests/login.spec.ts --headed --project=chromium",
    "test:public-navigation": "playwright test tests/public-navigation.spec.ts --project=chromium",
    "test:public-navigation:headed": "playwright test tests/public-navigation.spec.ts --headed --project=chromium",
    "test:signup": "playwright test tests/signup.spec.ts --project=chromium",
    "test:signup:headed": "playwright test tests/signup.spec.ts --headed --project=chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run test:chromium",
    "test:report": "npm run clean:reports && npm run test:chromium && npm run allure:generate",
    "clean:reports": "node -e \"const fs=require('node:fs'); for (const dir of ['allure-report','allure-results','playwright-report','test-results']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  }
}
