TASTELIFE_BASE_URL=https://uat.tastelifelivelife.com

# Required for valid login tests.
TASTELIFE_VALID_USERNAME=
TASTELIFE_VALID_PASSWORD=

# Optional. If omitted, TASTELIFE_VALID_USERNAME is used for registered forgot-password tests.
TASTELIFE_REGISTERED_EMAIL=

# Optional synthetic negative-test data.
TASTELIFE_INVALID_USERNAME=invalid.user@example.com
TASTELIFE_INVALID_PASSWORD=WrongPassword123!
TASTELIFE_UNREGISTERED_EMAIL=invalid.user@example.com
